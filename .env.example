# Copy this file to `.env` and fill in the value below.
# `.env` is gitignored and must never be committed.

# Required only for the AI-assisted analysis path (Phase 3).
# Get one at https://console.anthropic.com -> API keys -> Create key
# Without it the app still runs: analysis falls back to the rule-based engine.
ANTHROPIC_API_KEY=

# Optional. Set to "false" to force the rule-based engine even when a key
# is present - a one-second kill switch if the venue network is unreliable.
AI_ENABLED=true

# Optional. API server port (default 3001).
PORT=3001
