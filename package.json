{
  "name": "is-match-ai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -n api,web -c yellow,cyan \"npm run server\" \"npm run client\"",
    "client": "vite",
    "server": "node --env-file-if-exists=.env server/index.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "server:watch": "node --env-file-if-exists=.env --watch --watch-path=server --watch-path=shared server/index.js",
    "seed": "node scripts/seed-db.mjs",
    "test": "node --test",
    "smoke": "node scripts/smoke-render.mjs",
    "check": "npm run test && npm run smoke",
    "build": "vite build",
    "preview": "vite preview"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.124.0",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.544.0",
    "mammoth": "^1.10.0",
    "multer": "^2.0.2",
    "pdf-parse": "^1.1.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "recharts": "^3.1.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "tailwindcss": "^4.1.13",
    "vite": "^7.1.5"
  }
}
